# ============================================================================
# Hybrid Crowd Counting — Environment Configuration Example
# ============================================================================
# Copy this file to `.env` (in backend/ or frontend/ as needed) and fill in
# your local values. NEVER commit real `.env` files to Git.

# ----------------------------------------------------------------------------
# BACKEND CONFIGURATION (FastAPI)
# ----------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins for CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Optional: override the directory containing best.pt, best2.pt, csrnet_AB_best.pth
# Defaults to `<repo>/backend/models`
# MODELS_DIR=C:/Projects/hybrid-crowd-counting/backend/models

# Optional: explicit path to ffmpeg binary (used to transcode AVI -> H.264 MP4)
# If unset, the backend checks system PATH (`shutil.which("ffmpeg")`) and then `C:\ffmpeg\bin\ffmpeg.exe`
# FFMPEG_PATH=C:/ffmpeg/bin/ffmpeg.exe

# Optional: set to 1 during lightweight unit testing to skip eager YOLO loading at import time
# SKIP_STARTUP_MODEL_LOAD=0

# ----------------------------------------------------------------------------
# FRONTEND CONFIGURATION (React + Vite)
# ----------------------------------------------------------------------------
# IMPORTANT SECURITY NOTE:
# Any variable prefixed with `VITE_` is statically embedded into the client-side
# JavaScript bundle when running `npm run build` or `npm run dev`. Placing a key
# in `.env` prevents it from being committed to Git, but it is STILL PUBLICLY
# VISIBLE in the browser network tab and compiled bundle.
#
# Therefore, you MUST restrict your Google Maps API key in Google Cloud Console:
#   1. Application restrictions -> Websites (HTTP referrers):
#      - http://localhost:5173/*
#      - http://127.0.0.1:5173/*
#      - https://your-production-domain.example.com/*
#   2. API restrictions -> Restrict key -> Select ONLY "Maps JavaScript API"
#   3. Set quota/billing alerts on the Google Cloud project.
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_GOOGLE_MAPS_API_KEY=YOUR_RESTRICTED_GOOGLE_MAPS_BROWSER_KEY_HERE
VITE_GOOGLE_MAPS_MAP_ID=YOUR_GOOGLE_MAPS_MAP_ID_HERE
