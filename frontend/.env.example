# Copy to `frontend/.env` for local development. Never commit `frontend/.env`.
# NOTE: VITE_* variables are bundled into browser code and are NOT secrets.
# Restrict VITE_GOOGLE_MAPS_API_KEY by HTTP referrer and API scope in Google Cloud Console.
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_GOOGLE_MAPS_API_KEY=YOUR_RESTRICTED_GOOGLE_MAPS_BROWSER_KEY_HERE
VITE_GOOGLE_MAPS_MAP_ID=YOUR_GOOGLE_MAPS_MAP_ID_HERE
